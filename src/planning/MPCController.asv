classdef MPCController < handle
    properties
        opti
        N
        dt
        X
        U
        x0
        x_ref
    end

    methods
        function obj = MPCController(N, dt)
            import casadi.*

            obj.opti = casadi.Opti();
            obj.N = N;
            obj.dt = dt;

            % Decision variables
            obj.X = obj.opti.variable(5, N + 1); % [px; py; theta; v] across N+1 steps
            obj.U = obj.opti.variable(2, N);     % [omega; a] across N steps

            % Parameters passed at each timestep
            obj.x0    = obj.opti.parameter(5, 1);     % Current robot state
            obj.x_ref = obj.opti.parameter(5, N + 1); % Reference parking trajectory

            % Build optimization problem
            obj.add_constraints();
            obj.set_cost();

            % Configure IPOPT solver (silent output for fast loop execution)
            opts = struct();
            opts.ipopt.print_level = 0;
            opts.print_time = 0;
            obj.opti.solver('ipopt', opts);
        end

        function add_constraints(obj)
            % 1. Anchor initial predicted state to current measured state
            obj.opti.subject_to(obj.X(:, 1) == obj.x0);

            % 2. Enforce robot dynamics across the horizon
            for k = 1:obj.N
                next_state = rk4_step(obj.X(:, k), obj.U(:, k), obj.dt);
                obj.opti.subject_to(obj.X(:, k + 1) == next_state);
            end
        
            % 3. Physical actuator/speed limits (adjust to your EV3 motors)
            obj.opti.subject_to(-0.3 <= obj.X(4, :) <= 0.3); % v (m/s)
            obj.opti.subject_to(-2.0 <= obj.X(5, :) <= 2.0); % omega (rad/s)
            obj.opti.subject_to(-1.5 <= obj.U(1, :) <= 1.5); % linear accel a (m/s^2)
            obj.opti.subject_to(-3.0 <= obj.U(2, :) <= 3.0); % angular accel alpha (rad/s^2)
        end

        function set_cost(obj)
            % State weights: [px, py, theta, v, omega]
            Q = diag([15.0, 15.0, 1.0, 2.0, 2.0]);
            % Control effort weights: [a, alpha]
            R = diag([0.5, 0.5]);
        
            total_cost = 0;
            for k = 1:obj.N
                state_error = obj.X(:, k) - obj.x_ref(:, k);
                u_k = obj.U(:, k);
                total_cost = total_cost + state_error' * Q * state_error + u_k' * R * u_k;
            end
        
            % Final step state cost using the same Q
            final_error = obj.X(:, obj.N + 1) - obj.x_ref(:, obj.N + 1);
            total_cost = total_cost + final_error' * Q * final_error;
        
            obj.opti.minimize(total_cost);
        end

        function [u_opt, v_target] = solve(obj, current_state, reference_traj)
            % Set parameter values
            obj.opti.set_value(obj.x0, current_state);
            obj.opti.set_value(obj.x_ref, reference_traj);

            % Solve NLP
            sol = obj.opti.solve();

            % Extract optimal control sequence and predicted states
            U_sol = full(sol.value(obj.U));
            X_sol = full(sol.value(obj.X));

            % First optimal control input: [omega_0; a_0]
            u_opt = U_sol(:, 1);

            % Next desired linear velocity (useful for Ibrahim's wheel controller)
            v_target = X_sol(4, 2);
        end
    end
end